{
  "pages": [
    "pages/index/index",
    "pages/monitor/monitor",
    "pages/products/products",
    "pages/history/history",
    "pages/profile/profile",
    "pages/login/login",
    "pages/task-detail/task-detail",
    "pages/product-detail/product-detail",
    "pages/settings/settings"
  ],
  "window": {
    "backgroundTextStyle": "dark",
    "navigationBarBackgroundColor": "#4A90E2",
    "navigationBarTitleText": "闲鱼监控系统",
    "navigationBarTextStyle": "white",
    "backgroundColor": "#F5F5F5",
    "enablePullDownRefresh": true,
    "onReachBottomDistance": 50
  },
  "tabBar": {
    "color": "#7A7E83",
    "selectedColor": "#4A90E2",
    "borderStyle": "white",
    "backgroundColor": "#ffffff",
    "position": "bottom",
    "list": [
      {
        "pagePath": "pages/index/index",
        "iconPath": "images/monitor.png",
        "selectedIconPath": "images/monitor-active.png",
        "text": "监控面板"
      },
      {
        "pagePath": "pages/products/products",
        "iconPath": "images/results.png",
        "selectedIconPath": "images/results-active.png",
        "text": "发现商品"
      },
      {
        "pagePath": "pages/history/history",
        "iconPath": "images/history.png",
        "selectedIconPath": "images/history-active.png",
        "text": "历史记录"
      },
      {
        "pagePath": "pages/profile/profile",
        "iconPath": "images/profile.png",
        "selectedIconPath": "images/profile-active.png",
        "text": "我的"
      }
    ]
  },
  "networkTimeout": {
    "request": 30000,
    "downloadFile": 30000
  },
  "debug": false,
  "permission": {
    "scope.userLocation": {
      "desc": "您的位置信息将用于优化商品推荐"
    }
  },
  "requiredBackgroundModes": ["audio", "location"],
  "plugins": {},
  "resizable": true,
  "usingComponents": {
    "van-button": "@vant/weapp/button/index",
    "van-cell": "@vant/weapp/cell/index",
    "van-cell-group": "@vant/weapp/cell-group/index",
    "van-field": "@vant/weapp/field/index",
    "van-popup": "@vant/weapp/popup/index",
    "van-toast": "@vant/weapp/toast/index",
    "van-dialog": "@vant/weapp/dialog/index",
    "van-loading": "@vant/weapp/loading/index",
    "van-switch": "@vant/weapp/switch/index",
    "van-stepper": "@vant/weapp/stepper/index",
    "van-tag": "@vant/weapp/tag/index",
    "van-progress": "@vant/weapp/progress/index",
    "van-notice-bar": "@vant/weapp/notice-bar/index",
    "van-card": "@vant/weapp/card/index",
    "van-icon": "@vant/weapp/icon/index",
    "van-grid": "@vant/weapp/grid/index",
    "van-grid-item": "@vant/weapp/grid-item/index",
    "van-divider": "@vant/weapp/divider/index",
    "van-image": "@vant/weapp/image/index",
    "van-empty": "@vant/weapp/empty/index",
    "van-skeleton": "@vant/weapp/skeleton/index"
  },
  "lazyCodeLoading": "requiredComponents",
  "network": {
    "requestDomain": [],
    "socketDomain": [],
    "uploadFileDomain": [],
    "downloadFileDomain": []
  }
}
