      <van-tag class="status-tag" type="success">运行中</van-tag>
    </view>
    <view class="task-stats">
      <view class="stat-item">
        <view class="stat-number">156</view>
        <view class="stat-label">发现商品</view>
      </view>
      <view class="stat-item">
        <view class="stat-number">12</view>
        <view class="stat-label">低价预警</view>
