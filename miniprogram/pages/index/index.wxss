/* 监控面板首页样式 */

.container {
  position: relative;
  min-height: 100vh;
  background-color: #f5f5f5;
}

/* 自定义导航栏 */
.custom-navbar {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  z-index: 1000;
  background: linear-gradient(135deg, #4A90E2 0%, #357ABD 100%);
  color: white;
}

.navbar-content {
  display: flex;
  align-items: center;
  justify-content: center;
  height: 44px;
  position: relative;
}

.navbar-title {
  font-size: 18px;
  font-weight: 600;
  text-align: center;
}

.navbar-actions {
  position: absolute;
  right: 16px;
  top: 50%;
  transform: translateY(-50%);
}

.socket-status {
  width: 36px;
  height: 36px;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 50%;
  background-color: rgba(255, 255, 255, 0.1);
}

.socket-status.offline {
  background-color: rgba(255, 77, 79, 0.1);
}

/* 页面滚动区域 */
.page-scroll {
  height: 100vh;
  box-sizing: border-box;
}

/* Cookie通知 */
.cookie-notice {
  margin: 16px;
  border-radius: 8px;
  overflow: hidden;
}

/* 统计卡片 */
.stats-section {
  padding: 16px;
}

.stats-container {
  background: white;
  border-radius: 16px;
  padding: 24px 16px;
  box-shadow: 0 2px 12px rgba(0, 0, 0, 0.08);
  display: flex;
  justify-content: space-around;
}

.stats-item {
  text-align: center;
  flex: 1;
}

.stats-number {
  font-size: 28px;
  font-weight: 600;
  line-height: 1.2;
  margin-bottom: 8px;
}

.stats-number.primary {
  color: #1890ff;
}

.stats-number.success {
  color: #52c41a;
}

.stats-number.warning {
  color: #fa8c16;
}

.stats-number.error {
  color: #ff4d4f;
}

.stats-label {
  font-size: 12px;
  color: #999;
}

/* 快速操作 */
.quick-actions {
  padding: 0 16px 16px;
}

.action-buttons {
  display: flex;
  gap: 12px;
  padding: 16px 0;
}

.action-btn {
  flex: 1;
}

/* 任务列表 */
.tasks-section {
  padding: 0 16px 16px;
}

.task-list {
  padding: 0;
}

.task-item {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 16px;
  border-bottom: 1px solid #f0f0f0;
  transition: background-color 0.2s;
}

.task-item:last-child {
  border-bottom: none;
}

.task-item:active {
  background-color: #f8f8f8;
}

.task-info {
  flex: 1;
  margin-right: 12px;
}

.task-name {
  font-size: 16px;
  font-weight: 500;
  color: #333;
  margin-bottom: 8px;
}

.task-meta {
  display: flex;
  flex-direction: column;
  gap: 4px;
}

.task-keywords {
  display: flex;
  flex-wrap: wrap;
  gap: 4px;
}

.task-stats {
  font-size: 12px;
  color: #999;
}

.task-actions {
  display: flex;
  align-items: center;
}

/* 空状态 */
.empty-tasks {
  padding: 0 16px;
}

.empty-state {
  background: white;
  border-radius: 16px;
  padding: 40px 20px;
  text-align: center;
  box-shadow: 0 2px 12px rgba(0, 0, 0, 0.08);
}

/* 最近活动 */
.activities-section {
  padding: 0 16px 16px;
}

.activity-list {
  padding: 0;
}

.activity-item {
  display: flex;
  align-items: flex-start;
  padding: 12px 16px;
  border-bottom: 1px solid #f0f0f0;
  transition: background-color 0.2s;
}

.activity-item:last-child {
  border-bottom: none;
}

.activity-item:active {
  background-color: #f8f8f8;
}

.activity-icon {
  width: 32px;
  height: 32px;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 50%;
  background-color: #f5f5f5;
  margin-right: 12px;
  flex-shrink: 0;
}

.activity-item.newProducts .activity-icon {
  background-color: #e6f7ff;
}

.activity-item.lowPriceAlert .activity-icon {
  background-color: #fff2f0;
}

.activity-item.roundComplete .activity-icon {
  background-color: #f6ffed;
}

.activity-content {
  flex: 1;
  margin-right: 8px;
}

.activity-title {
  font-size: 14px;
  font-weight: 500;
  color: #333;
  margin-bottom: 4px;
}

.activity-desc {
  font-size: 12px;
  color: #666;
  line-height: 1.4;
  margin-bottom: 4px;
}

.activity-time {
  font-size: 11px;
  color: #999;
}

.activity-count {
  flex-shrink: 0;
}

/* 加载状态 */
.loading-container {
  display: flex;
  align-items: center;
  justify-content: center;
  flex-direction: column;
  padding: 40px;
  color: #999;
}

.loading-text {
  margin-top: 12px;
  font-size: 14px;
}

/* 悬浮操作按钮 */
.fab {
  position: fixed;
  right: 24px;
  bottom: 100px;
  width: 56px;
  height: 56px;
  background: linear-gradient(135deg, #4A90E2 0%, #357ABD 100%);
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: 0 4px 16px rgba(74, 144, 226, 0.4);
  z-index: 999;
  transition: all 0.3s;
}

.fab:active {
  transform: scale(0.95);
}

/* 底部安全区域 */
.safe-area-bottom {
  height: constant(safe-area-inset-bottom);
  height: env(safe-area-inset-bottom);
  padding-bottom: 20px;
}

/* 卡片样式 */
.card {
  background: white;
  border-radius: 16px;
  box-shadow: 0 2px 12px rgba(0, 0, 0, 0.08);
  overflow: hidden;
}

.card-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 16px 16px 0;
  margin-bottom: 16px;
}

.card-title {
  font-size: 16px;
  font-weight: 600;
  color: #333;
}

.card-extra {
  font-size: 12px;
  color: #1890ff;
}

/* 响应式调整 */
@media screen and (max-width: 375px) {
  .stats-number {
    font-size: 24px;
  }
  
  .stats-label {
    font-size: 11px;
  }
  
  .task-name {
    font-size: 15px;
  }
  
  .fab {
    width: 48px;
    height: 48px;
    right: 20px;
    bottom: 90px;
  }
}

/* 深色模式适配 */
@media (prefers-color-scheme: dark) {
  .container {
    background-color: #1a1a1a;
  }
  
  .stats-container,
  .card,
  .empty-state {
    background-color: #2a2a2a;
  }
  
  .task-item,
  .activity-item {
    border-bottom-color: #3a3a3a;
  }
  
  .task-item:active,
  .activity-item:active {
    background-color: #3a3a3a;
  }
  
  .card-title,
  .task-name,
  .activity-title {
    color: #e0e0e0;
  }
  
  .activity-desc {
    color: #b0b0b0;
  }
  
  .activity-time,
  .task-stats,
  .stats-label {
    color: #888;
  }
}
