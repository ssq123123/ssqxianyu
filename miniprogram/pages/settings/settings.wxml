<view class="container">
  <view class="settings-section">
    <view class="section-title">通用设置</view>
    <view class="setting-item">
      <view class="setting-content">
        <view class="setting-title">声音提醒</view>
        <view class="setting-desc">新商品与预警时播放提示音</view>
      </view>
      <view class="setting-action">
        <van-switch checked="{{soundAlert}}" bind:change="onToggleSound" />
      </view>
    </view>
    <view class="setting-item">
      <view class="setting-content">
        <view class="setting-title">默认监控间隔（秒）</view>
      </view>
      <view class="setting-action">
        <van-stepper value="{{defaultInterval}}" min="10" max="600" step="10" bind:change="onIntervalChange" />
      </view>
    </view>
  </view>

  <view class="settings-section danger-section">
    <view class="section-title">高级</view>
    <view class="setting-item" bind:tap="onClearCache">
      <view class="setting-content">
        <view class="setting-title">清理缓存</view>
        <view class="setting-desc">清空本地存储数据</view>
      </view>
    </view>
  </view>
</view>