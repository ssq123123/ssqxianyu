<view class="container">
  <view class="user-section">
    <image class="user-avatar" src="/images/logo.png" mode="aspectFill" />
    <view class="user-name">测试用户</view>
    <view class="user-desc">欢迎使用闲鱼监控系统</view>
  </view>

  <view class="menu-section">
    <view class="menu-item" bind:tap="onGoSettings">
      <view class="menu-content">
        <view class="menu-title">设置</view>
        <view class="menu-desc">通知、缓存、网络等</view>
      </view>
    </view>
    <view class="menu-item" bind:tap="onLogout">
      <view class="menu-content">
        <view class="menu-title">退出登录</view>
        <view class="menu-desc">清除本地数据并返回登录</view>
      </view>
    </view>
  </view>
</view>