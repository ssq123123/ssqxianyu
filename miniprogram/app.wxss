/**app.wxss**/
@import 'miniprogram_npm/@vant/weapp/common/index.wxss';

/* 全局样式重置 */
page {
  background-color: #f5f5f5;
  font-family: -apple-system, BlinkMacSystemFont, "Helvetica Neue", Helvetica, "PingFang SC", "Hiragino Sans GB", "Microsoft YaHei", SimSun, sans-serif;
  font-size: 14px;
  line-height: 1.6;
  color: #333;
}

/* 容器样式 */
.container {
  min-height: 100vh;
  padding-bottom: constant(safe-area-inset-bottom);
  padding-bottom: env(safe-area-inset-bottom);
}

.page-container {
  padding: 20rpx;
}

.content-container {
  background: #fff;
  border-radius: 16rpx;
  margin-bottom: 20rpx;
  overflow: hidden;
}

/* 导航栏相关 */
.navbar {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  z-index: 1000;
  background: linear-gradient(135deg, #4A90E2 0%, #357ABD 100%);
  color: white;
}

.navbar-content {
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 8rpx 32rpx;
}

.navbar-title {
  font-size: 36rpx;
  font-weight: 600;
  text-align: center;
}

.navbar-back {
  position: absolute;
  left: 32rpx;
  top: 50%;
  transform: translateY(-50%);
  width: 60rpx;
  height: 60rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

/* 卡片样式 */
.card {
  background: #fff;
  border-radius: 16rpx;
  margin: 20rpx;
  padding: 32rpx;
  box-shadow: 0 2rpx 12rpx rgba(0, 0, 0, 0.08);
}

.card-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 24rpx;
  padding-bottom: 24rpx;
  border-bottom: 2rpx solid #f0f0f0;
}

.card-title {
  font-size: 32rpx;
  font-weight: 600;
  color: #333;
}

.card-subtitle {
  font-size: 24rpx;
  color: #999;
  margin-top: 8rpx;
}

.card-content {
  font-size: 28rpx;
  line-height: 1.6;
  color: #666;
}

/* 列表样式 */
.list-item {
  display: flex;
  align-items: center;
  padding: 24rpx 32rpx;
  background: #fff;
  border-bottom: 2rpx solid #f0f0f0;
  transition: background-color 0.3s;
}

.list-item:active {
  background-color: #f8f8f8;
}

.list-item:last-child {
  border-bottom: none;
}

.list-item-icon {
  width: 80rpx;
  height: 80rpx;
  margin-right: 24rpx;
  border-radius: 50%;
  background: #f0f0f0;
  display: flex;
  align-items: center;
  justify-content: center;
}

.list-item-content {
  flex: 1;
}

.list-item-title {
  font-size: 30rpx;
  font-weight: 500;
  color: #333;
  margin-bottom: 8rpx;
}

.list-item-desc {
  font-size: 24rpx;
  color: #999;
}

.list-item-arrow {
  width: 32rpx;
  height: 32rpx;
  opacity: 0.3;
}

/* 状态样式 */
.status-running {
  color: #52c41a;
}

.status-stopped {
  color: #999;
}

.status-error {
  color: #ff4d4f;
}

.status-paused {
  color: #fa8c16;
}

/* 标签样式 */
.tag {
  display: inline-block;
  padding: 8rpx 16rpx;
  font-size: 20rpx;
  border-radius: 8rpx;
  margin-right: 16rpx;
  margin-bottom: 8rpx;
}

.tag-primary {
  background: #e6f7ff;
  color: #1890ff;
}

.tag-success {
  background: #f6ffed;
  color: #52c41a;
}

.tag-warning {
  background: #fff7e6;
  color: #fa8c16;
}

.tag-error {
  background: #fff2f0;
  color: #ff4d4f;
}

.tag-info {
  background: #f0f0f0;
  color: #666;
}

/* 商品卡片样式 */
.product-card {
  background: #fff;
  border-radius: 16rpx;
  margin: 20rpx;
  overflow: hidden;
  box-shadow: 0 2rpx 12rpx rgba(0, 0, 0, 0.08);
}

.product-image {
  width: 200rpx;
  height: 200rpx;
  border-radius: 12rpx;
  margin-right: 24rpx;
}

.product-info {
  flex: 1;
  display: flex;
  flex-direction: column;
  justify-content: space-between;
}

.product-title {
  font-size: 28rpx;
  font-weight: 500;
  color: #333;
  line-height: 1.4;
  margin-bottom: 12rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  display: -webkit-box;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
}

.product-price {
  font-size: 32rpx;
  font-weight: 600;
  color: #ff4d4f;
  margin-bottom: 8rpx;
}

.product-meta {
  font-size: 24rpx;
  color: #999;
}

.product-keyword {
  background: #e6f7ff;
  color: #1890ff;
  padding: 4rpx 12rpx;
  border-radius: 8rpx;
  font-size: 20rpx;
  margin-right: 12rpx;
}

/* 统计样式 */
.stats-container {
  display: flex;
  background: #fff;
  border-radius: 16rpx;
  overflow: hidden;
}

.stats-item {
  flex: 1;
  text-align: center;
  padding: 32rpx 16rpx;
  border-right: 2rpx solid #f0f0f0;
}

.stats-item:last-child {
  border-right: none;
}

.stats-number {
  font-size: 48rpx;
  font-weight: 600;
  color: #333;
  line-height: 1.2;
}

.stats-label {
  font-size: 24rpx;
  color: #999;
  margin-top: 8rpx;
}

.stats-number.primary {
  color: #1890ff;
}

.stats-number.success {
  color: #52c41a;
}

.stats-number.warning {
  color: #fa8c16;
}

.stats-number.error {
  color: #ff4d4f;
}

/* 按钮样式 */
.btn-primary {
  background: linear-gradient(135deg, #4A90E2 0%, #357ABD 100%);
  color: white;
  border: none;
  border-radius: 12rpx;
  padding: 24rpx 48rpx;
  font-size: 30rpx;
  font-weight: 500;
}

.btn-secondary {
  background: #f0f0f0;
  color: #666;
  border: none;
  border-radius: 12rpx;
  padding: 24rpx 48rpx;
  font-size: 30rpx;
}

.btn-danger {
  background: #ff4d4f;
  color: white;
  border: none;
  border-radius: 12rpx;
  padding: 24rpx 48rpx;
  font-size: 30rpx;
  font-weight: 500;
}

.btn-success {
  background: #52c41a;
  color: white;
  border: none;
  border-radius: 12rpx;
  padding: 24rpx 48rpx;
  font-size: 30rpx;
  font-weight: 500;
}

.btn-small {
  padding: 16rpx 32rpx;
  font-size: 24rpx;
}

.btn-large {
  padding: 32rpx 64rpx;
  font-size: 32rpx;
}

/* 输入框样式 */
.form-item {
  margin-bottom: 32rpx;
}

.form-label {
  font-size: 28rpx;
  color: #333;
  margin-bottom: 16rpx;
  font-weight: 500;
}

.form-input {
  width: 100%;
  padding: 24rpx 32rpx;
  border: 2rpx solid #d9d9d9;
  border-radius: 12rpx;
  font-size: 28rpx;
  background: #fff;
}

.form-input:focus {
  border-color: #4A90E2;
}

.form-textarea {
  width: 100%;
  min-height: 200rpx;
  padding: 24rpx 32rpx;
  border: 2rpx solid #d9d9d9;
  border-radius: 12rpx;
  font-size: 28rpx;
  background: #fff;
  resize: vertical;
}

/* 空状态样式 */
.empty-state {
  text-align: center;
  padding: 120rpx 60rpx;
  color: #999;
}

.empty-state-icon {
  width: 200rpx;
  height: 200rpx;
  margin: 0 auto 32rpx;
  opacity: 0.3;
}

.empty-state-text {
  font-size: 28rpx;
  color: #999;
  margin-bottom: 32rpx;
}

.empty-state-button {
  display: inline-block;
  padding: 20rpx 40rpx;
  background: #4A90E2;
  color: white;
  border-radius: 8rpx;
  font-size: 26rpx;
  text-decoration: none;
}

/* 加载状态 */
.loading-container {
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 60rpx;
  color: #999;
}

.loading-text {
  margin-left: 20rpx;
  font-size: 26rpx;
}

/* 分隔线 */
.divider {
  height: 2rpx;
  background: #f0f0f0;
  margin: 32rpx 0;
}

/* 通知样式 */
.notice {
  padding: 24rpx 32rpx;
  margin: 20rpx;
  border-radius: 12rpx;
  font-size: 26rpx;
  line-height: 1.5;
}

.notice-info {
  background: #e6f7ff;
  color: #1890ff;
  border-left: 6rpx solid #1890ff;
}

.notice-success {
  background: #f6ffed;
  color: #52c41a;
  border-left: 6rpx solid #52c41a;
}

.notice-warning {
  background: #fff7e6;
  color: #fa8c16;
  border-left: 6rpx solid #fa8c16;
}

.notice-error {
  background: #fff2f0;
  color: #ff4d4f;
  border-left: 6rpx solid #ff4d4f;
}

/* 动画效果 */
.fade-in {
  animation: fadeIn 0.3s ease-in;
}

@keyframes fadeIn {
  from {
    opacity: 0;
    transform: translateY(20rpx);
  }
  to {
    opacity: 1;
    transform: translateY(0);
  }
}

.slide-up {
  animation: slideUp 0.3s ease-out;
}

@keyframes slideUp {
  from {
    opacity: 0;
    transform: translateY(60rpx);
  }
  to {
    opacity: 1;
    transform: translateY(0);
  }
}

/* 响应式设计 */
@media screen and (max-width: 375px) {
  .card {
    margin: 16rpx;
    padding: 24rpx;
  }
  
  .product-card {
    margin: 16rpx;
  }
}

/* 深色模式支持 */
@media (prefers-color-scheme: dark) {
  page {
    background-color: #1a1a1a;
    color: #e0e0e0;
  }
  
  .card,
  .content-container,
  .product-card {
    background: #2a2a2a;
  }
  
  .list-item {
    background: #2a2a2a;
    border-bottom-color: #3a3a3a;
  }
  
  .form-input,
  .form-textarea {
    background: #2a2a2a;
    border-color: #3a3a3a;
    color: #e0e0e0;
  }
}

/* 工具类 */
.text-center {
  text-align: center;
}

.text-left {
  text-align: left;
}

.text-right {
  text-align: right;
}

.flex {
  display: flex;
}

.flex-center {
  display: flex;
  align-items: center;
  justify-content: center;
}

.flex-between {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.flex-column {
  display: flex;
  flex-direction: column;
}

.flex-1 {
  flex: 1;
}

.mt-small {
  margin-top: 16rpx;
}

.mt-medium {
  margin-top: 32rpx;
}

.mt-large {
  margin-top: 48rpx;
}

.mb-small {
  margin-bottom: 16rpx;
}

.mb-medium {
  margin-bottom: 32rpx;
}

.mb-large {
  margin-bottom: 48rpx;
}

.p-small {
  padding: 16rpx;
}

.p-medium {
  padding: 32rpx;
}

.p-large {
  padding: 48rpx;
}

.text-small {
  font-size: 22rpx;
}

.text-medium {
  font-size: 26rpx;
}

.text-large {
  font-size: 32rpx;
}

.text-primary {
  color: #1890ff;
}

.text-success {
  color: #52c41a;
}

.text-warning {
  color: #fa8c16;
}

.text-error {
  color: #ff4d4f;
}

.text-gray {
  color: #999;
}

.text-bold {
  font-weight: 600;
}

.bg-primary {
  background-color: #1890ff;
}

.bg-success {
  background-color: #52c41a;
}

.bg-warning {
  background-color: #fa8c16;
}

.bg-error {
  background-color: #ff4d4f;
}
